---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Figure from '../components/Figure.astro';
import { withBase } from '../lib/paths';
import '../styles/prose.css';
interface Props { project: CollectionEntry<'projects'>; headings: {depth:number;slug:string;text:string}[] }
const { project, headings } = Astro.props;
const p = project.data;
const related = (await getCollection('projects')).filter(x => x.id !== project.id).sort((a,b) => a.data.order-b.data.order).slice(0,2);
---
<SiteLayout title={`${p.title} | 한석진 포트폴리오`} description={p.description}>
  <article>
    <header class="case-header shell">
      <a class="back-link text-link" href={withBase('/#cases')}><span aria-hidden="true">←</span> 전체 사례로 돌아가기</a>
      <p class="case-project">{p.title} <span>{p.kind === 'team' ? '팀 프로젝트' : '개인 프로젝트'} · {p.period}</span></p>
      <h1>{p.lead}</h1><p class="case-description">{p.description}</p>
      <dl class="case-meta"><div><dt>담당</dt><dd>{p.role}</dd></div><div><dt>현재 상태</dt><dd>{p.status === 'in-development' ? '개발 중 · 변경 버전 검증 전' : '구현 경험과 확인 범위 기록'}</dd></div></dl>
      <div class="case-summary"><div><dt>문제</dt><dd>{p.summary.problem}</dd></div><div><dt>판단</dt><dd>{p.summary.decision}</dd></div><div><dt>확인</dt><dd>{p.summary.outcome}</dd></div></div>
      {p.hero && <Figure {...p.hero} sourceUrl={p.hero.sourceUrl || p.sources[0]?.url} eager />}
    </header>
    <div class="case-body shell">
      <nav class="case-toc" aria-label="사례 목차"><p>이 사례에서</p><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
      <div class="prose"><slot />
        {p.sources.length>0 && <section class="case-sources"><h2 id="sources">코드와 근거</h2><ul>{p.sources.map(source=><li><a href={source.url}>{source.label} <span aria-hidden="true">↗</span></a></li>)}</ul></section>}
      </div>
    </div>
  </article>
  <section class="related-section soft"><div class="shell"><h2>다른 문제, 같은 질문.</h2><div class="more-list">{related.map(x=><a class="more-link" href={withBase(`/projects/${x.id}/`)}><h3>{x.data.title}</h3><p>{x.data.description}</p><span>사례 읽기 →</span></a>)}</div></div></section>
  <section class="case-contact shell"><h2>함께 풀어갈 문제가 있다면.</h2><ContactLinks /></section>
</SiteLayout>
