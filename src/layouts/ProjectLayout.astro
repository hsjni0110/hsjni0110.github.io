---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import SiteLayout from './SiteLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import TechTags from '../components/TechTags.astro';
import PencilFigure from '../components/PencilFigure.astro';
import Sketch from '../components/Sketch.astro';
import Figure from '../components/Figure.astro';
import { withBase } from '../lib/paths';
import '../styles/prose.css';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const p = project.data;
const related = (await getCollection('projects')).filter(x => x.id !== project.id).sort((a,b) => a.data.order-b.data.order).slice(0,2);
---
<SiteLayout title={`${p.title} | 한석진 포트폴리오`} description={p.description}>
  <article>
    <header class="case-header shell">
      <a class="back-link text-link" href={withBase('/#cases')}><span aria-hidden="true">←</span> 전체 사례로 돌아가기</a>
      <p class="case-project">{p.title} <span>{p.kind === 'team' ? '팀 프로젝트' : '개인 프로젝트'} · {p.period}</span></p>
      <div class="case-title-art"><h1>{p.lead}</h1><Sketch kind={project.id==='speaktext'?'voice':project.id==='forgesync'?'data':'work'} /></div>
      {['speaktext','forgesync'].includes(project.id) && <TechTags items={project.id==='speaktext'?['Java','Spring Boot','LLM']:['Python','Java','Spring Boot','TypeScript','PostgreSQL']} />}
      {p.hero && <Figure {...p.hero} sourceUrl={p.hero.sourceUrl || p.sources[0]?.url} eager />}
    </header>
    <div class="case-body shell">
      <div class="prose"><PencilFigure kind={project.id as 'speaktext'|'forgesync'|'db-fleet-ops'|'reservation-system'} /><slot />
        {p.sources.length>0 && <section class="case-sources"><h2 id="sources">코드·문서</h2><ul>{p.sources.map(source=><li><a href={source.url}>{source.label} <span aria-hidden="true">↗</span></a></li>)}</ul></section>}
      </div>
    </div>
  </article>
  <section class="related-section soft"><div class="shell"><h2>다른 프로젝트</h2><div class="more-list">{related.map(x=><a class="more-link" href={withBase(`/projects/${x.id}/`)}><h3>{x.data.title}</h3><p>{x.data.description}</p><span>사례 읽기 →</span></a>)}</div></div></section>
  <section class="case-contact shell"><h2>채용·협업 문의</h2><ContactLinks /></section>
</SiteLayout>
