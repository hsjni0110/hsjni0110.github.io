---
import SiteHeader from '../components/SiteHeader.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
import og from '../assets/og.png';
import regularFont from '../assets/fonts/Pretendard-Regular.woff2?url';
import '../styles/global.css';
interface Props { title: string; description: string; ogImage?: string }
const { title, description, ogImage } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const image = Astro.site ? new URL(ogImage || og.src, Astro.site).href : undefined;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><meta name="description" content={description} /><meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" /><meta property="og:locale" content="ko_KR" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}{image && <meta property="og:image" content={image} />}
  </head>
  <body><SiteHeader /><main id="main"><slot /></main>
    <footer class="site-footer"><div class="shell footer-inner"><a class="wordmark" href={withBase('/')}>한석진</a><p>문제를 이해하고, 해결책을 끝까지.</p><a href={`mailto:${profile.email}`}>{profile.email}</a></div></footer>
  </body>
</html>
