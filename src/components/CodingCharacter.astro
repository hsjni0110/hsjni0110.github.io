---
import { getImage } from 'astro:assets';
import sheet from '../assets/illustration/coding-loop-v1.png';
const sprite=await getImage({src:sheet,width:1400,format:'webp'});
---
<div class="character-player" data-playing="false">
  <div class="coding-sprite" role="img" aria-label="코딩에 몰입하다가 답답해서 책상을 두드리고, 해결되자 놀란 뒤 다시 코딩하는 한석진 캐릭터" style={{backgroundImage:`url('${sprite.src}')`}}></div>
  <button class="character-control" type="button" hidden>움직임 일시정지</button>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.character-player').forEach(player=>{
    const button=player.querySelector<HTMLButtonElement>('button')!;
    const motion=matchMedia('(prefers-reduced-motion: reduce)');
    const setPlaying=(playing:boolean)=>{
      player.dataset.playing=String(playing&&!motion.matches);
      button.textContent=motion.matches?'정지 화면':player.dataset.playing==='true'?'움직임 일시정지':'움직임 재생';
      button.disabled=motion.matches;
    };
    button.hidden=false;setPlaying(true);
    button.addEventListener('click',()=>setPlaying(player.dataset.playing!=='true'));
    motion.addEventListener('change',()=>setPlaying(false));
  });
</script>
<style>
.character-player{position:relative;width:min(100%,490px);margin-inline:auto}.coding-sprite{width:100%;aspect-ratio:1;background-size:200% 200%;background-position:0 0;background-repeat:no-repeat;mix-blend-mode:multiply}.character-player[data-playing=true] .coding-sprite{animation:code-loop 4.8s steps(1,end) infinite}.character-control{display:block;margin:10px 8px 0 auto;border:0;border-bottom:1px solid #9dbec5;background:transparent;color:#4b687b;font:inherit;font-size:11px;padding:8px 0;min-height:44px;cursor:pointer}.character-control[hidden]{display:none}.character-control:disabled{border:0;cursor:default}.character-control:hover{color:#23344f}@keyframes code-loop{0%,27%{background-position:0 0}28%,39%{background-position:100% 0}40%,59%{background-position:0 100%}60%,100%{background-position:100% 100%}}@media(max-width:760px){.character-player{max-width:360px}.character-control{margin-top:0;font-size:10px}}
</style>
