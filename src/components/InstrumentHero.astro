---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';
import { profile } from '../data/profile';
const work = [
  { id:'batch', name:'데이터 적재', title:'배치 지연 분석과 분산 적재', description:'중간 결과가 모이는 구간을 분석하고, 분산 테이블에 직접 적재하는 방식으로 변경했습니다.', href:'#experience', caption:'적재 경로 · 개념도', nodes:['분산 원본','중간 테이블','분산 대상'], revised:['분산 원본','직접 적재','분산 대상'], before:'변경 전', after:'변경 후' },
  { id:'voice', name:'음성 편집', title:'발화자 오류를 고치는 편집 기능', description:'대사가 다른 인물에게 연결되는 오류를 확인하고, 발화자별 색 구분과 일괄 수정 화면·API를 구현했습니다.', href:'#speaktext', caption:'발화자 수정 · 개념도', nodes:['원문 분할','음성 생성','연결 오류'], revised:['색 구분','대사 선택','일괄 수정'], before:'생성', after:'편집' },
  { id:'record', name:'설비 기록', title:'기록 누락과 정지의 구분', description:'기록이 없다는 이유로 정지를 확정하지 않도록 분류 기준을 바꾸고, 당시 원본 기록을 조회하는 화면을 구현했습니다.', href:'#forgesync', caption:'기록 분류 · 개념도', nodes:['작업','기록 공백','정지'], revised:['작업','기록 없음','정지'], before:'관측', after:'구분' },
];
---
<section class="instrument-hero shell" aria-labelledby="intro-title">
  <div class="instrument-caption"><span>개발자 포트폴리오</span><span>한석진 / SELECTED WORK</span></div>
  <div class="instrument-body">
    <i class="case-screw screw-a" aria-hidden="true"></i><i class="case-screw screw-b" aria-hidden="true"></i><i class="case-screw screw-c" aria-hidden="true"></i><i class="case-screw screw-d" aria-hidden="true"></i>
    <div class="instrument-identity">
      <p class="instrument-role">백엔드 개발자</p><h1 id="intro-title">한석진</h1>
      <p class="instrument-specialty">서비스 백엔드<br />데이터 파이프라인</p>
      <div class="instrument-contact"><a class="instrument-email" href={`mailto:${profile.email}`}>이메일로 연락하기 <span aria-hidden="true">↗</span></a><a href="#cases">전체 사례 <span aria-hidden="true">↓</span></a></div>
      <div class="instrument-id"><Image src={portrait} alt="개발자 한석진" width={144} loading="eager" /><div><span>HAN SEOKJIN</span><p>분석 · 구현 · 검증</p></div><div class="vent" aria-hidden="true"></div></div>
    </div>
    <fieldset class="instrument-selector"><legend>작업 선택</legend>
      {work.map((item,i)=><input class="work-radio" type="radio" id={`select-${item.id}`} name="work-channel" value={item.id} checked={i===0} />)}
      <div class="instrument-display">
        <div class="display-top"><span><i aria-hidden="true"></i> 작업 기록</span><span>01 — 03</span></div>
        {work.map((item,i)=><div class={`display-page page-${item.id}`}>
          <div class="display-heading"><span class="display-number">0{i+1}</span><h2>{item.title}</h2></div>
          <div class="signal-diagram" aria-label={item.caption}><div class="signal-row"><span>{item.before}</span>{item.nodes.map((node,n)=><><b class:list={{'signal-middle':n===1}}>{node}</b>{n<2&&<i aria-hidden="true">→</i>}</>)}</div><div class="signal-row signal-new"><span>{item.after}</span>{item.revised.map((node,n)=><><b class:list={{'signal-middle':n===1}}>{node}</b>{n<2&&<i aria-hidden="true">→</i>}</>)}</div><p>{item.caption}</p></div>
          <p class="display-description">{item.description}</p><a class="display-link" href={item.href}>작업 내용 보기 <span aria-hidden="true">↗</span></a>
        </div>)}
      </div>
      <div class="instrument-controls">{work.map((item,i)=><label for={`select-${item.id}`} class={`control-${item.id}`}><span class="key-number">0{i+1}</span><span>{item.name}</span><i aria-hidden="true"></i></label>)}</div>
      <div class="instrument-control-note"><span>버튼으로 작업 선택</span><span aria-hidden="true">● ● ●</span></div>
    </fieldset>
  </div>
  <div class="instrument-manual"><span>INDEX / 01</span><p>실무 경험과 프로젝트</p><a href="#experience" aria-label="실무 경험으로 이동">아래로 읽기 <span aria-hidden="true">↓</span></a></div>
</section>
<style>
.instrument-hero{padding-top:35px;padding-bottom:28px}.instrument-caption{display:flex;justify-content:space-between;font-size:10px;color:#676963;letter-spacing:.06em;margin-bottom:12px}.instrument-caption span:last-child{font-family:monospace}.instrument-body{position:relative;display:grid;grid-template-columns:.85fr 1.5fr;gap:48px;padding:54px 52px 40px;border:1px solid #c9c9c1;border-radius:20px;background:linear-gradient(135deg,#f0f0e9,#e1e2da);box-shadow:inset 0 2px 1px #ffffffdb,inset 0 -3px 3px #b4b6ab55,0 20px 38px -28px #1c242180,0 4px 5px #2228190a}.case-screw{position:absolute;width:8px;height:8px;border-radius:50%;background:#b4b6ac;border:1px solid #a0a298;box-shadow:inset 0 1px 2px #7779}.case-screw:after{content:'';position:absolute;width:5px;height:1px;background:#777c70;left:1px;top:3px;transform:rotate(-35deg)}.screw-a{top:17px;left:18px}.screw-b{top:17px;right:18px}.screw-c{bottom:17px;left:18px}.screw-d{bottom:17px;right:18px}.instrument-identity{display:flex;flex-direction:column;align-items:start;padding-top:8px}.instrument-role{font-size:13px;color:#5b6058}.instrument-identity h1{font-size:clamp(58px,6.5vw,88px);line-height:1.2;letter-spacing:-.07em;margin-top:12px;color:#292d28}.instrument-identity h1::after{content:'.';color:#d84c24}.instrument-specialty{margin-top:24px;font-size:18px;line-height:1.65;color:#4c534a}.instrument-contact{display:flex;flex-direction:column;align-items:start;margin:32px 0 36px;font-size:13px;gap:8px}.instrument-contact a{display:flex;gap:22px;align-items:center;min-height:38px}.instrument-email{font-weight:600;border-bottom:1px solid #9c9f93}.instrument-contact a:hover{color:#af3617}.instrument-id{display:flex;align-items:center;gap:12px;margin-top:auto;width:100%;border-top:1px solid #c4c7bc;padding-top:22px}.instrument-id img{width:34px;height:44px;object-fit:cover;filter:grayscale(1);border-radius:2px}.instrument-id span{font:10px monospace;letter-spacing:.08em;color:#555c50}.instrument-id p{font-size:10px;color:#747a6d;margin-top:5px}.vent{margin-left:auto;width:47px;height:28px;background:repeating-linear-gradient(90deg,transparent 0 5px,#b0b5a8 5px 7px);border-radius:2px}.instrument-selector{border:0;padding:0;margin:0;min-width:0;align-self:stretch}.instrument-selector legend{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.work-radio{position:absolute;width:1px;height:1px;opacity:0}.instrument-display{background:#202923;color:#e9eee5;border:6px solid #373d35;border-radius:10px;padding:22px 24px 23px;box-shadow:0 1px 0 #ffffffc9,inset 0 2px 8px #0005;min-height:340px}.display-top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #485346;padding-bottom:13px;color:#abb8a5;font:10px monospace}.display-top>span:first-child{display:flex;gap:8px;align-items:center}.display-top i{width:5px;height:5px;background:#dbe9b6;border-radius:50%;box-shadow:0 0 7px #dbe9b644}.display-page{display:none}.instrument-selector:has(#select-batch:checked) .page-batch,.instrument-selector:has(#select-voice:checked) .page-voice,.instrument-selector:has(#select-record:checked) .page-record{display:block;animation:display-in .22s ease-out}.display-heading{display:flex;gap:14px;align-items:start;margin-top:24px}.display-number{font:11px monospace;color:#aab897;padding-top:5px}.display-heading h2{font-size:22px;letter-spacing:-.035em;line-height:1.4}.signal-diagram{margin-top:24px}.signal-row{display:flex;align-items:center;gap:9px;margin-top:12px}.signal-row>span{font-size:9px;color:#a6b39d;width:37px;flex-shrink:0}.signal-row b{font-size:10px;font-weight:400;text-align:center;flex:1;border:1px solid #54634d;border-radius:3px;padding:8px 3px;white-space:nowrap}.signal-row i{font-style:normal;color:#7d8e72;font-size:13px}.signal-row .signal-middle{border-style:dashed;color:#a6b39d}.signal-new .signal-middle{border-style:solid;color:#ecf1c5;border-color:#9aaa6f;background:#8ba25e16}.signal-diagram>p{font-size:9px;text-align:right;color:#829279;margin-top:9px}.display-description{font-size:12px;line-height:1.85;color:#b6c1ae;margin-top:20px}.display-link{font-size:11px;min-height:35px;display:inline-flex;align-items:center;gap:22px;color:#e6edc8;margin-top:7px}.display-link:hover{color:white;text-decoration:underline}.instrument-controls{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:19px}.instrument-controls label{position:relative;display:flex;flex-direction:column;gap:9px;align-items:start;cursor:pointer;padding:13px 15px 16px;border:1px solid #c3c6ba;border-radius:7px;background:linear-gradient(#f9f9f2,#e9ebe2);color:#42493d;box-shadow:0 3px 0 #b4b8aa,0 4px 5px #69745a22,inset 0 1px 0 white;transition:transform .15s,box-shadow .15s,background .15s;font-size:12px;font-weight:600}.key-number{font:10px monospace;color:#777f6d}.instrument-controls label i{position:absolute;right:12px;top:15px;width:5px;height:5px;background:#b6bdac;border-radius:50%}.instrument-selector:has(#select-batch:checked) .control-batch,.instrument-selector:has(#select-voice:checked) .control-voice,.instrument-selector:has(#select-record:checked) .control-record{transform:translateY(2px);background:linear-gradient(#e4653f,#d8532e);border-color:#bd4928;color:#fff8ed;box-shadow:0 1px 0 #a64225,inset 0 1px 0 #f5a083}.instrument-selector:has(input:checked) label .key-number{color:inherit;opacity:.7}.instrument-selector:has(#select-batch:checked) .control-batch i,.instrument-selector:has(#select-voice:checked) .control-voice i,.instrument-selector:has(#select-record:checked) .control-record i{background:#fff3b9}.work-radio:focus-visible~.instrument-controls{outline:2px solid #ad3819;outline-offset:5px;border-radius:7px}.instrument-control-note{display:flex;justify-content:space-between;font-size:9px;color:#71796a;margin-top:14px}.instrument-control-note>span:last-child{letter-spacing:7px;color:#a3ac98}.instrument-manual{display:flex;align-items:center;gap:20px;margin-top:28px;font-size:11px;color:#72796e}.instrument-manual>span{font:9px monospace;color:#7b8473}.instrument-manual a{margin-left:auto;display:flex;gap:22px;align-items:center;min-height:44px}@keyframes display-in{from{opacity:.5;transform:translateY(3px)}to{opacity:1;transform:none}}@media(max-width:1000px){.instrument-body{gap:30px;padding:45px 32px 35px;grid-template-columns:.8fr 1.4fr}.instrument-display{padding:18px;min-height:360px}.display-heading h2{font-size:20px}.signal-row{gap:5px}.signal-row b{font-size:9px}.instrument-controls label{padding:12px 10px;font-size:11px}}@media(max-width:760px){.instrument-hero{padding-top:23px}.instrument-caption{font-size:9px}.instrument-caption span:last-child{font-size:8px}.instrument-body{grid-template-columns:1fr;gap:28px;padding:33px 20px 30px;border-radius:15px}.instrument-identity{position:relative}.instrument-identity h1{font-size:56px;margin-top:6px}.instrument-specialty{font-size:13px;margin-top:14px}.instrument-contact{margin:16px 0 0;flex-direction:row;gap:24px;font-size:11px}.instrument-id{position:absolute;right:0;top:2px;flex-direction:column;align-items:end;gap:8px;border:0;width:auto;padding:0}.instrument-id img{width:32px;height:40px}.instrument-id span{font-size:8px}.instrument-id p,.vent{display:none}.instrument-display{border-width:4px;padding:17px 15px;min-height:335px}.display-heading{margin-top:18px;gap:10px}.display-heading h2{font-size:20px}.signal-row{gap:5px}.signal-row>span{width:30px;font-size:8px}.signal-row b{font-size:9px;padding:8px 2px}.display-description{font-size:12px}.instrument-controls{gap:9px;margin-top:15px}.instrument-controls label{padding:12px 10px 14px}.instrument-controls label i{right:10px;top:15px}.instrument-manual{gap:10px;font-size:10px;margin-top:16px}.instrument-manual>span{font-size:8px}}
</style>
