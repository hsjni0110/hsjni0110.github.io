---
import CodingCharacter from './CodingCharacter.astro';
import { profile } from '../data/profile';
---
<section class="portrait-hero" aria-labelledby="intro-title">
  <div class="portrait-hero-inner shell">
    <div class="portrait-intro">
      <p class="portrait-eyebrow">안녕하세요. 백엔드 개발자</p>
      <h1 id="intro-title">한석진<span aria-hidden="true">입니다.</span></h1>
      <p class="portrait-specialty">서비스 백엔드와<br />데이터 파이프라인을 개발합니다.</p>
      <div class="portrait-actions"><a class="portrait-primary" href="#cases">작업 살펴보기 <span aria-hidden="true">↘</span></a><a href={`mailto:${profile.email}`}>이메일로 연락하기 <span aria-hidden="true">↗</span></a></div>

    </div>
    <div class="portrait-art character-art"><CodingCharacter /></div>
  </div>
  <div class="portrait-work shell" aria-label="주요 작업 바로가기">
    <a href="#experience"><span>01</span><strong>배치 지연 분석과 분산 적재</strong><i aria-hidden="true">↗</i></a>
    <a href="#speaktext"><span>02</span><strong>발화자 오류를 고치는 편집 기능</strong><i aria-hidden="true">↗</i></a>
    <a href="#forgesync"><span>03</span><strong>기록 누락과 정지의 구분</strong><i aria-hidden="true">↗</i></a>
  </div>
</section>
<style>
.portrait-hero{background:#edf7f8;color:#23344f;overflow:hidden;border-bottom:1px solid #d7e8e9}.portrait-hero-inner{display:grid;grid-template-columns:1fr 1fr;align-items:center;position:relative;min-height:650px;padding-top:55px;padding-bottom:35px;gap:20px}.portrait-intro{position:relative;z-index:2;padding-bottom:25px}.portrait-eyebrow{font-size:18px;letter-spacing:-.025em;color:#52627a;margin-bottom:22px}.portrait-intro h1{font-size:clamp(68px,7.4vw,102px);letter-spacing:-.065em;line-height:1.2;color:#23344f}.portrait-intro h1 span{display:block;font-size:.64em;font-weight:400;margin-top:6px;letter-spacing:-.05em}.portrait-specialty{font-size:21px;color:#4e6179;line-height:1.8;margin-top:27px}.portrait-actions{display:flex;align-items:center;gap:27px;flex-wrap:wrap;margin-top:33px}.portrait-actions a{display:inline-flex;align-items:center;justify-content:space-between;gap:22px;min-height:48px;font-size:13px}.portrait-actions .portrait-primary{padding:12px 20px;background:#24364f;color:#fff;border-radius:3px;box-shadow:4px 4px 0 #8bc7c7;transition:transform .2s,box-shadow .2s}.portrait-actions .portrait-primary:hover{transform:translate(2px,2px);box-shadow:2px 2px 0 #8bc7c7}.portrait-actions>a:last-child:hover{text-decoration:underline;color:#23344f}.portrait-smallprint{display:flex;align-items:center;gap:15px;margin-top:45px;color:#63778c}.portrait-smallprint>span{font-size:38px;line-height:1;color:#75b7b8}.portrait-smallprint p{font-size:11px;line-height:1.7}.portrait-art{position:relative;align-self:center;isolation:isolate;min-width:0;padding-top:15px}.portrait-art img{position:relative;z-index:2;width:100%;max-height:570px;object-fit:contain;transform:rotate(-3deg);transform-origin:50% 80%;transition:transform .65s cubic-bezier(.2,.7,.2,1)}.portrait-art:hover img{transform:rotate(0) translateY(-5px)}.portrait-pattern{position:absolute;z-index:-1;left:-18%;right:-12%;top:34%;height:41%;background:repeating-linear-gradient(135deg,transparent 0 5px,#9dcdcd8c 5px 7px);transform:rotate(-5deg);border-radius:3px}.portrait-orbit{position:absolute;border:2px solid #71b8b8;border-radius:50%;z-index:3}.orbit-one{width:21px;height:21px;top:13%;right:3%;background:#edf7f8}.orbit-two{width:10px;height:10px;left:0;bottom:20%;background:#ef947e;border:0}.portrait-signature{position:absolute;right:5%;bottom:1%;z-index:3;font-size:12px;color:#596d82;background:#edf7f8;padding:7px 12px;border:1px solid #c4dddd;transform:rotate(-7deg)}.portrait-signature i{font-style:normal;margin-left:10px;color:#bd654b}.portrait-work{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;align-items:start;padding-top:24px;padding-bottom:30px;border-top:1px solid #cbdfe1}.portrait-index-label{font-size:11px;color:#687f91;padding-top:10px}.portrait-work>a{min-width:0;display:grid;grid-template-columns:20px minmax(0,1fr) 14px;gap:10px;padding:7px 0;min-height:48px;align-items:start;color:#354c64}.portrait-work>a>span{font:10px monospace;color:#709b9f;padding-top:5px}.portrait-work strong{min-width:0;word-break:keep-all;overflow-wrap:normal;font-weight:400;font-size:13px;line-height:1.8}.portrait-work i{font-style:normal;color:#668e94;transition:transform .2s}.portrait-work a:hover strong{text-decoration:underline}.portrait-work a:hover i{transform:translate(3px,-3px)}@media(max-width:1000px){.portrait-hero-inner{min-height:590px}.portrait-intro h1{font-size:70px}.portrait-eyebrow{font-size:15px}.portrait-specialty{font-size:17px}.portrait-actions{gap:20px}.portrait-work{grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.portrait-work strong{font-size:12px}}@media(max-width:760px){.portrait-hero-inner{grid-template-columns:1fr;gap:0;padding-top:38px;padding-bottom:15px;min-height:0}.portrait-intro{padding-bottom:0}.portrait-eyebrow{font-size:14px;margin-bottom:14px}.portrait-intro h1{font-size:65px}.portrait-intro h1 span{display:inline;font-size:.53em;margin-left:12px}.portrait-specialty{font-size:16px;margin-top:20px}.portrait-actions{margin-top:24px;gap:24px}.portrait-actions a{font-size:12px}.portrait-smallprint{display:none}.portrait-art{width:85%;margin-left:auto;margin-right:0;margin-top:24px;padding:0}.portrait-art img{max-height:375px}.portrait-pattern{left:-25%;right:-15%;top:35%}.portrait-signature{right:0;bottom:0;font-size:10px}.orbit-one{width:15px;height:15px;right:0}.portrait-work{grid-template-columns:1fr;gap:2px;padding-top:18px;padding-bottom:22px}.portrait-index-label{padding:0 0 8px}.portrait-work>a{grid-template-columns:22px 1fr 18px;min-height:44px;align-items:center;gap:10px;padding:8px 0}.portrait-work strong{font-size:13px}.portrait-work>a>span{padding:0}}
</style>
