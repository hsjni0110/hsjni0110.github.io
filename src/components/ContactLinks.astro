---
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
---
<div class="contact-links">
  <a class="button primary" href={`mailto:${profile.email}`}>이메일로 연락하기 <span aria-hidden="true">↗</span></a>
  <a class="text-link" href={withBase('/resume.pdf')}>이력서 PDF <span aria-hidden="true">↗</span></a>
  <a class="text-link" href={profile.githubUrl}>GitHub <span aria-hidden="true">↗</span></a>
  <a class="text-link" href={profile.velogUrl}>Velog <span aria-hidden="true">↗</span></a>
</div>
