---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';
import Figure from './Figure.astro';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const p = project.data;
---
<section class:list={['section', 'project-story', {soft: project.id === 'forgesync'}]} data-project={project.id}>
  <div class="shell">
    <div class="project-head"><strong>{p.title}</strong><span>{p.kind === 'team' ? '팀 프로젝트' : '개인 프로젝트'}{p.status === 'in-development' ? ' · 개발 중' : ''}</span></div>
    <h2>{p.lead}</h2><p class="story-description">{p.summary.problem}<br />{p.summary.decision}</p>
    <a class="text-link story-link" href={withBase(`/projects/${project.id}/`)}>사례 읽기 <span aria-hidden="true">→</span></a>
    {project.id === 'speaktext' && <>
      <div class="editorial-panel">
        <blockquote>발화자 확인과<br />잘못 연결된<br />대사 수정</blockquote>
        <ol><li><span>↳</span><div><strong>인물의 일관성</strong><p>이전 등장인물 정보를 다음 생성에 전달</p></div></li><li><span>↳</span><div><strong>작가의 검토와 수정</strong><p>등장인물 이름·목소리와 대사 연결을 확인·수정</p></div></li><li><span>↳</span><div><strong>수정의 편의</strong><p>발화자별 색 구분과 여러 대사를 수정하는 API 구현</p></div></li></ol>
      </div>
      <p class="panel-caption">작가의 검토·수정 흐름을 요약한 도식</p>
      <div class="project-points"><div><strong>제가 맡은 일</strong><p>스크립트·인물 동기화·음성 생성 흐름과 편집 개선안, 화면·API 구현</p></div><div><strong>팀과 확인한 변화</strong><p>{p.summary.outcome} 정량 효과는 미측정.</p></div></div>
    </>}
    {project.id === 'forgesync' && <>
      {p.hero && <Figure {...p.hero} sourceUrl={p.sources[0]?.url} />}
      <div class="project-points"><div><strong>조사할 구간과 당시 기록</strong><p>가공 시간의 변화와 해당 시점의 기록 조회. 센서 편차는 참고 정보로 제공.</p></div><div><strong>검증 범위</strong><p>설비 1대의 하루 기록 활용. 실제 불량 여부와 현장 사용성은 미검증.</p></div></div>
    </>}
    {project.id === 'shared-life' && <>
      <div class="comparison"><div><p class="comparison-label">이전 기획</p><h3>입력하고 대화하며,<br />일정을 관리받기.</h3><p>일정 입력과 AI 대화가 필요한 사용 방식</p></div><div><p class="comparison-label">현재의 방향</p><h3>앱을 켜고,<br />각자의 일을 함께하기.</h3><p>캐릭터의 일상과 함께한 시간에 따라 쌓이는 관계</p></div></div>
      <p class="development-note">{p.summary.outcome}</p>
    </>}
  </div>
</section>
