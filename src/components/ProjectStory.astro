---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { withBase } from '../lib/paths';
import Sketch from './Sketch.astro';
import before from '../assets/projects/forgesync/before.webp';
import after from '../assets/projects/forgesync/overview.webp';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const p = project.data;
const speak = project.id==='speaktext';
---
<article class:list={['project-story', { 'forge-story': !speak, 'text-case': speak }]} id={project.id} data-project={project.id}>
  <div class="shell">
    <div class="project-heading" data-reveal><Sketch kind={speak?'voice':'data'} class="project-sketch" /><div class="project-head"><span class="project-count">{speak?'01':'02'}</span><strong>{p.title}</strong><span>{p.kind === 'team' ? '팀 프로젝트' : '개인 프로젝트'} · {p.period}</span></div><p class="service-intro">{speak?'소설을 등장인물별 스크립트와 음성으로 바꾸고, 작가가 생성 결과를 편집하는 서비스입니다.':'CNC 설비 기록을 재생하며 정지·가공 시간 변화 구간과 당시 기록을 조사하는 도구입니다.'}</p></div>
    <div class="story-grid">
      <div class="story-copy" data-reveal>
        <h3>{speak?<>발화자 색 구분과<br />대사 일괄 수정</>:<>기록 누락·정지 분리와<br />원본 기록 조회</>}</h3>
        <p class="story-description">{speak?'생성된 음성에서 대사가 다른 인물에게 연결되는 오류를 확인했습니다. 발화자별 색 구분을 제안하고 대사 일괄 수정 화면과 API를 구현했습니다.':'기록이 없다는 이유로 정지를 확정하지 않도록 분류 기준을 바꿨습니다. 하루 요약에서 조사할 구간을 고르고 당시 원본 기록을 확인하는 화면을 구현했습니다.'}</p>
        <div class="case-preview-links"><a class="text-link story-link" href={withBase(`/projects/${project.id}/`)}>사례 읽기 <span aria-hidden="true">↗</span></a></div>
      </div>
      {!speak && <div class="comparison-evidence" data-reveal>
        <figure class="compare-current"><Image src={after} alt="개선 후: 작업·멈춤·기록 없음을 구분한 ForgeSync 화면" widths={[640,1120]} sizes="(max-width: 760px) calc(100vw - 40px), 56vw" /><figcaption><span class="evidence-label">개선 후</span>기록이 없는 시간과 실제 정지를 분리했습니다.</figcaption></figure>
        <details class="before-evidence"><summary>개선 전 화면 비교 <span class="disclosure-mark" aria-hidden="true">+</span></summary><figure><Image src={before} alt="개선 전: 기록 누락과 정지가 구분되지 않던 ForgeSync 화면" widths={[640,1120]} sizes="(max-width: 760px) calc(100vw - 40px), 56vw" /><figcaption>기록이 없는 시간까지 정지로 읽힐 수 있던 기존 화면입니다.</figcaption></figure></details>
      </div>}
    </div>

  </div>
</article>
