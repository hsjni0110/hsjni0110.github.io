---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectStory from '../components/ProjectStory.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Experience from '../components/Experience.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
import portrait from '../assets/portrait.webp';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<SiteLayout title="한석진 | 문제를 이해하고 해결하는 개발자" description="배치 처리 개선, 발화자 편집, 설비 기록 분석과 앱 기획을 담은 개발자 한석진의 포트폴리오입니다.">
  <section class="hero shell">
    <div class="identity"><Image src={portrait} alt="개발자 한석진" width={176} loading="eager" /><div><p class="identity-name">한석진</p><p class="identity-role">문제를 이해하고 해결하는 개발자</p></div></div>
    <h1><span>문제를 구체적으로 정의하고,</span>{' '}<span>구현과 검증까지 맡습니다.</span></h1>
    <p class="hero-description">모플에서는 매일 실행되는 배치의 지연을 분석하고 개선했습니다. SpeakText에서는 잘못 연결된 발화자를 찾아 수정하기 쉽도록 화면과 API를 만들었습니다.</p>
    <div class="hero-actions"><a class="button primary" href="#cases">대표 사례 보기 <span aria-hidden="true">↓</span></a><a class="text-link" href={`mailto:${profile.email}`}>이메일로 연락하기 <span aria-hidden="true">↗</span></a></div>
    <div class="hero-note"><span>백엔드·데이터 파이프라인 실무 경험</span><span>문제 분석 → 해결책 선택 → 구현 → 결과 확인</span></div>
  </section>
  <div class="cases-heading shell" id="cases"><h2>대표 사례</h2><p>발화자 수정, 설비 기록 해석, 앱의 입력 부담. 각 문제에서 무엇을 바꿨는지 소개합니다.</p></div>
  {projects.filter(x=>x.data.featured).map(project=><ProjectStory project={project} />)}
  <section class="section soft" id="experience"><div class="shell"><div class="section-intro"><span class="section-label">실무 경험</span><h2>분석부터 구현,<br />결과 확인까지 맡았습니다.</h2><p>매일 실행되는 배치의 지연 원인을 분석하고, 개선안을 검토해 구현과 결과 확인까지 담당했습니다.</p></div><Experience /></div></section>
  <section class="section"><div class="shell"><div class="section-intro"><span class="section-label">더 깊이 살펴본 문제</span><h2>복원 가능성과<br />좌석 정합성을 다룬 학습 프로젝트</h2></div><div class="more-list">{projects.filter(x=>!x.data.featured).map(x=><a class="more-link" href={withBase(`/projects/${x.id}/`)}><h3>{x.data.title}</h3><p>{x.data.summary.problem}</p><span>사례 읽기 <span aria-hidden="true">→</span></span></a>)}</div></div></section>
  <section class="section soft" id="about"><div class="shell"><div class="section-intro"><span class="section-label">함께 일하는 사람으로서</span><h2>구현 경험을 바탕으로,<br />해결할 문제를 찾고 있습니다.</h2></div><div class="about-grid"><div class="about-copy"><p>회사에서는 기능 구현과 데이터 처리 개선을 맡았고, 제조지능화 아카데미에서는 설비 기록을 해석하는 문제를 다뤘습니다. 지금은 구현 방법을 정하기 전에 누가 어떤 상황에서 어려움을 겪는지 먼저 살펴봅니다.</p><p>멋쟁이사자처럼에서 2024년 교육생, 2025년 운영진으로 활동했습니다. 다른 팀과 창업에 관심 있는 사람들을 만나며, 완성도 있게 구현해도 사람들이 필요로 하지 않을 수 있다는 점을 느꼈습니다.</p><p>현재는 혼자 일을 시작하기 어려웠던 경험을 바탕으로 동시생활 앱을 개발하고 있습니다. 기존 버전의 테스터 피드백을 받고 기획을 바꿨으며, 새 버전의 효과는 앞으로 확인할 예정입니다.</p></div><div class="credentials">{[...profile.education,...profile.activities].map(x=><div><h3>{x.title}</h3><p>{x.detail}</p></div>)}</div></div></div></section>
  <section class="contact-section" id="contact"><div class="shell"><h2>개발자 한석진에게 연락하기</h2><p>채용과 협업 문의는 이메일로 보내주세요.</p><ContactLinks /><a class="contact-address" href={`mailto:${profile.email}`}>{profile.email}</a></div></section>
</SiteLayout>
