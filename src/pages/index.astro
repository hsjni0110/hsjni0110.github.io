---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectStory from '../components/ProjectStory.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Experience from '../components/Experience.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
import portrait from '../assets/portrait.webp';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
const app = projects.find(x=>x.id==='shared-life')!;
---
<SiteLayout title="한석진 | ‘끝났다’는 말의 조건을 묻는 개발자" description="생성된 음성의 오류, 설비 기록의 빈틈, 적재 결과의 정합성. 실제로 쓰는 순간의 문제를 다루는 개발자 한석진의 포트폴리오.">
  <section class="hero shell" aria-labelledby="intro-title">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="identity"><Image src={portrait} alt="개발자 한석진" width={144} loading="eager" /><div><p class="identity-name">한석진</p><p class="identity-role">백엔드 개발 · 데이터 파이프라인</p></div></div>
        <h1 id="intro-title"><span>“<em>끝났다</em>”는 말의</span>{' '}<span>조건을 묻습니다.</span></h1>
        <p class="hero-description">결과가 만들어진 뒤에도 남는 문제들.<br />확인하고, 고치고, 실제로 쓰는 순간까지 살핍니다.</p>
        <div class="hero-actions"><a class="button primary" href="#cases">대표 사례 보기 <span aria-hidden="true">↘</span></a><a class="text-link" href={`mailto:${profile.email}`}>이메일로 연락하기 <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="question-index" aria-label="작업으로 이어진 세 가지 질문">
        <p class="index-label">제 작업은 이런 질문에서 시작됩니다.</p>
        <a href="#speaktext"><span class="index-number">01</span><div><span class="index-context">SpeakText · 생성 결과의 오류</span><p>음성이 나왔으면,<br />작업은 끝난 걸까요?</p></div><span class="index-arrow" aria-hidden="true">↗</span></a>
        <a href="#forgesync"><span class="index-number">02</span><div><span class="index-context">ForgeSync · 기록의 해석</span><p>기록이 없으면,<br />설비는 멈춘 걸까요?</p></div><span class="index-arrow" aria-hidden="true">↗</span></a>
        <a href="#experience"><span class="index-number">03</span><div><span class="index-context">모플 · 적재 결과 검증</span><p>빨라진 배치,<br />결과도 맞을까요?</p></div><span class="index-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-foot"><p>서비스 개발과 데이터 처리 실무에서,<br class="mobile-only" /> 사용자·운영자의 문제로.</p><span>아래로 이어지는 작업 기록 <span aria-hidden="true">↓</span></span></div>
  </section>

  <section class="section experience-section" id="experience" aria-labelledby="work-title">
    <div class="shell"><div class="section-heading" data-reveal><span class="section-label">실무 경험</span><h2 id="work-title">느린 배치의 병목 분석,<br />적재 결과의 정합성 검증</h2><p>배치 지연의 원인 분석과 적재 검증,<br />서비스의 기능 구현과 반복 작업 개선.</p></div><Experience /></div>
  </section>

  <section class="selected-work" id="cases" aria-labelledby="cases-title">
    <div class="shell section-heading" data-reveal><span class="section-label">대표 사례</span><h2 id="cases-title">오류가 남는 자동 생성과<br />빈틈이 있는 설비 기록</h2><p>무엇을 만드는 프로젝트인지, 어떤 문제를 발견했고<br />제가 무엇을 바꿨는지 연결해서 담았습니다.</p></div>
    {projects.filter(x=>x.data.featured && x.id!=='shared-life').map(project=><ProjectStory project={project} />)}
  </section>

  <section class="ongoing-section section" data-project="shared-life" aria-labelledby="ongoing-title">
    <div class="shell ongoing-grid" data-reveal>
      <div><span class="section-label"><span class="status-dot" aria-hidden="true"></span> 지금 만들고 있는 것</span><h2 id="ongoing-title">일정 관리에서<br />캐릭터와의 동시생활로</h2><p class="ongoing-name">{app.data.title}</p><a class="text-link" href={withBase('/projects/shared-life/')}>기획을 바꾼 이유 읽기 <span aria-hidden="true">→</span></a></div>
      <div class="ongoing-copy"><p>혼자서는 할 일을 알아도 시작하고 이어가기 어려웠습니다. 일정을 입력하고 AI와 대화하는 방식 대신, 앱을 켜고 자기 일을 하면 캐릭터도 자기 일상을 보내는 앱을 개발하고 있습니다.</p><p>함께한 시간이 관계로 쌓이는 재미가 다시 책상에 앉을 이유가 될 수 있을지 확인하려 합니다.</p><div class="scope-note"><strong>현재 단계</strong><p>데스크톱·모바일 개발 중입니다. 기존 버전의 테스터 피드백을 받고 기획을 바꿨으며, 변경 버전은 아직 사용자 검증 전입니다.</p></div></div>
    </div>
  </section>

  <section class="section archive-section"><div class="shell"><div class="archive-heading"><span class="section-label">추가 학습 기록</span><h2>복원 가능성과 좌석 정합성</h2></div><div class="more-list">{projects.filter(x=>!x.data.featured).map(x=><a class="more-link" href={withBase(`/projects/${x.id}/`)} data-reveal><div><span class="archive-type">학습 프로젝트</span><h3>{x.data.title}</h3></div><p>{x.data.summary.decision}</p><span>사례 읽기 <span aria-hidden="true">↗</span></span></a>)}</div></div></section>

  <section class="section about-section" id="about"><div class="shell about-grid">
    <div class="about-copy" data-reveal><span class="section-label">함께 일하는 사람으로서</span><h2>서비스 개발 경험과<br />문제를 다시 보는 과정</h2><p>회사에서는 기능을 구현하고 데이터 처리 지연을 개선했습니다. 동아리와 제조지능화 교육, 개인 제품 개발을 거치며 ‘어떻게 만들지’ 앞에 ‘누구에게 왜 필요한지’를 놓게 됐습니다.</p><p>관심 분야가 바뀌어도, 만든 결과를 누가 어떻게 쓰는지는 계속 확인하고 싶습니다.</p></div>
    <div class="credentials">{[...profile.education,...profile.activities].map(x=><details class="credential" data-reveal><summary><div><h3>{x.title}</h3><span>{x.detail}</span></div><span class="disclosure-mark" aria-hidden="true">+</span></summary><p>{x.description}</p></details>)}</div>
  </div></section>

  <section class="contact-section" id="contact"><div class="shell contact-grid" data-reveal><div><span class="section-label">다음 작업을 함께할 동료에게</span><h2>어떤 문제를<br />함께 풀게 될까요?</h2><p>개발자 한석진입니다.<br />채용과 협업 이야기를 기다립니다.</p></div><div><ContactLinks /><a class="contact-address" href={`mailto:${profile.email}`}>{profile.email}</a></div></div></section>
</SiteLayout>
