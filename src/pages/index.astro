---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectStory from '../components/ProjectStory.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Experience from '../components/Experience.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
import portrait from '../assets/portrait.webp';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<SiteLayout title="한석진 | 문제를 이해하고 해결하는 개발자" description="누구의 어떤 문제인지 먼저 이해하고, 상황에 맞는 해결책을 끝까지 만드는 개발자 한석진의 포트폴리오입니다.">
  <section class="hero shell">
    <div class="identity"><Image src={portrait} alt="개발자 한석진" width={176} loading="eager" /><div><p class="identity-name">한석진</p><p class="identity-role">문제를 이해하고 해결하는 개발자</p></div></div>
    <h1><span>누구의 어떤 문제인지부터</span>{' '}<span>생각합니다.</span></h1>
    <p class="hero-description">기술을 구현하는 경험을 바탕으로,<br />왜 필요한지 묻고 상황에 맞는 해결책을 끝까지 만듭니다.</p>
    <div class="hero-actions"><a class="button primary" href="#cases">대표 사례 보기 <span aria-hidden="true">↓</span></a><a class="text-link" href={`mailto:${profile.email}`}>이메일로 연락하기 <span aria-hidden="true">↗</span></a></div>
    <div class="hero-note"><span>백엔드·데이터 파이프라인 실무에서, 사용자와 도메인의 문제로.</span><span>선택의 이유를 담은 포트폴리오</span></div>
  </section>
  <section class="intro-block shell" id="cases"><h2>구현하는 방법에서,<br />만들어야 하는 이유로 관심을 넓혀왔습니다.</h2><p>회사에서의 개발, 동아리에서 만난 사람들, 제조지능화 교육과 사이드 프로젝트. 서로 다른 경험을 거치며 한 가지 질문이 남았습니다. <strong>이것은 누구의 어떤 문제를 해결하는가?</strong></p></section>
  {projects.filter(x=>x.data.featured).map(project=><ProjectStory project={project} />)}
  <section class="section soft" id="experience"><div class="shell"><div class="section-intro"><span class="section-label">실무 경험</span><h2>분석부터 구현,<br />결과 확인까지 맡았습니다.</h2><p>문제를 이해한 뒤에는 실제로 동작하는 결과가 필요합니다. 서비스의 기능을 만들고, 매일 실행되는 데이터 처리 과정을 개선했습니다.</p></div><Experience /></div></section>
  <section class="section"><div class="shell"><div class="section-intro"><span class="section-label">더 깊이 살펴본 문제</span><h2>해결책에는,<br />선택의 이유가 있어야 하니까.</h2></div><div class="more-list">{projects.filter(x=>!x.data.featured).map(x=><a class="more-link" href={withBase(`/projects/${x.id}/`)}><h3>{x.data.title}</h3><p>{x.data.summary.problem}</p><span>판단과 구현 읽기 <span aria-hidden="true">→</span></span></a>)}</div></div></section>
  <section class="section soft" id="about"><div class="shell"><div class="section-intro"><span class="section-label">함께 일하는 사람으로서</span><h2>왜 만드는지 고민하고,<br />믿고 맡길 수 있는 동료로.</h2></div><div class="about-grid"><div class="about-copy"><p>이전에는 기술을 잘 구현하는 데 많은 관심을 두었습니다. 회사와 아카데미, 사이드 프로젝트를 거치며 실제로 필요한 문제를 찾는 일이 더 중요하다고 느끼게 됐습니다.</p><p>멋쟁이사자처럼에서 교육생과 운영진으로 활동하며, 기술적으로 잘 만드는 것과 사람들이 필요로 하는 것이 다를 수 있음을 배웠습니다.</p><p>지금은 스마트 팩토리를 비롯한 여러 도메인을 탐구합니다. 창업에도 관심을 두고 직접 시장을 조사하고, 작은 제품을 만들어 사용자의 반응을 확인하고 있습니다.</p></div><div class="credentials">{[...profile.education,...profile.activities].map(x=><div><h3>{x.title}</h3><p>{x.detail}</p></div>)}</div></div></div></section>
  <section class="contact-section" id="contact"><div class="shell"><h2>함께 풀어갈 문제가 있다면.</h2><p>어떤 문제를 고민하고 계신지 듣고 싶습니다.</p><ContactLinks /><a class="contact-address" href={`mailto:${profile.email}`}>{profile.email}</a></div></section>
</SiteLayout>
