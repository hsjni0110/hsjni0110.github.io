---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectStory from '../components/ProjectStory.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Experience from '../components/Experience.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
import portrait from '../assets/portrait.webp';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<SiteLayout title="한석진 | 문제를 이해하고 해결하는 개발자" description="배치 처리 개선, 발화자 편집, 설비 기록 분석과 앱 기획을 담은 개발자 한석진의 포트폴리오">
  <section class="hero shell">
    <div class="identity"><Image src={portrait} alt="개발자 한석진" width={176} loading="eager" /><div><p class="identity-name">한석진</p><p class="identity-role">문제를 이해하고 해결하는 개발자</p></div></div>
    <h1><span>문제를 정의하고,</span>{' '}<span>구현과 검증까지 맡는 개발자</span></h1>
    <div class="hero-actions"><a class="button primary" href="#cases">대표 사례 보기 <span aria-hidden="true">↓</span></a><a class="text-link" href={`mailto:${profile.email}`}>이메일로 연락하기 <span aria-hidden="true">↗</span></a></div>
    <div class="hero-note"><span>백엔드·데이터 파이프라인 실무 경험</span><span>문제 분석 → 해결책 선택 → 구현 → 결과 확인</span></div>
  </section>
  <div class="cases-heading shell" id="cases"><h2>대표 사례</h2><p>발화자 수정 · 설비 기록 해석 · 앱의 입력 부담 개선</p></div>
  {projects.filter(x=>x.data.featured).map(project=><ProjectStory project={project} />)}
  <section class="section soft" id="experience"><div class="shell"><div class="section-intro"><span class="section-label">실무 경험</span><h2>배치 지연 분석부터<br />처리 시간 단축까지</h2><p>매일 실행되는 배치의 지연 원인 분석부터 개선안 검토·구현·결과 확인까지 담당</p></div><Experience /></div></section>
  <section class="section"><div class="shell"><div class="section-intro"><span class="section-label">더 깊이 살펴본 문제</span><h2>복원 가능성과<br />좌석 정합성을 다룬 학습 프로젝트</h2></div><div class="more-list">{projects.filter(x=>!x.data.featured).map(x=><a class="more-link" href={withBase(`/projects/${x.id}/`)}><h3>{x.data.title}</h3><p>{x.data.summary.problem}</p><span>사례 읽기 <span aria-hidden="true">→</span></span></a>)}</div></div></section>
  <section class="section soft" id="about"><div class="shell"><div class="section-intro"><span class="section-label">함께 일하는 사람으로서</span><h2>구현 경험을 바탕으로 한<br />사용자·도메인 문제 탐색</h2></div><div class="about-grid"><div class="about-copy"><p>회사에서의 기능 구현·데이터 처리 개선, 제조지능화 아카데미에서의 설비 기록 분석 경험. 이후 구현 방법보다 누가 어떤 상황에서 어려움을 겪는지 먼저 살피는 방향으로 관심 확장.</p><p>멋쟁이사자처럼 2024년 교육생·2025년 운영진 활동. 다른 팀과 창업에 관심 있는 사람들과의 교류를 통해 기술적 완성도와 실제 수요의 차이 인식.</p><p>현재는 혼자 일을 시작하기 어려웠던 경험을 바탕으로 동시생활 앱 개발 중. 기존 버전의 테스터 피드백을 받은 뒤 기획 변경. 새 버전의 효과는 검증 예정.</p></div><div class="credentials">{[...profile.education,...profile.activities].map(x=><div><h3>{x.title}</h3><p>{x.detail}</p></div>)}</div></div></div></section>
  <section class="contact-section" id="contact"><div class="shell"><h2>개발자 한석진에게 연락하기</h2><p>채용·협업 문의 채널: 이메일</p><ContactLinks /><a class="contact-address" href={`mailto:${profile.email}`}>{profile.email}</a></div></section>
</SiteLayout>
