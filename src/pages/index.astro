---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectStory from '../components/ProjectStory.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Experience from '../components/Experience.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
import portrait from '../assets/portrait.webp';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<SiteLayout title="한석진 | 백엔드 개발자" description="생성된 음성의 오류, 설비 기록의 빈틈, 적재 결과의 정합성. 실제로 쓰는 순간의 문제를 다루는 개발자 한석진의 포트폴리오.">
  <section class="hero shell" aria-labelledby="intro-title">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="identity"><Image src={portrait} alt="개발자 한석진" width={144} loading="eager" /><p class="identity-role">백엔드 개발자</p></div>
        <h1 id="intro-title">한석진</h1>
        <p class="hero-description">서비스 백엔드 · 데이터 파이프라인</p>
        <div class="hero-actions"><a class="button primary" href="#cases">대표 사례 보기 <span aria-hidden="true">↘</span></a><a class="text-link" href={`mailto:${profile.email}`}>이메일로 연락하기 <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="work-index" aria-label="주요 작업 바로가기">
        <p class="index-label">주요 작업</p>
        <a href="#experience"><span class="index-number">01</span><div><span class="index-context">모플 · 실무 경험</span><p>배치 지연 분석과 분산 적재</p></div><span class="index-arrow" aria-hidden="true">↘</span></a>
        <a href="#speaktext"><span class="index-number">02</span><div><span class="index-context">SpeakText · 소설 음성 제작</span><p>발화자 오류를 고치는 편집 기능</p></div><span class="index-arrow" aria-hidden="true">↘</span></a>
        <a href="#forgesync"><span class="index-number">03</span><div><span class="index-context">ForgeSync · 설비 기록 분석</span><p>기록 누락과 정지의 구분</p></div><span class="index-arrow" aria-hidden="true">↘</span></a>
      </div>
    </div>

  </section>

  <section class="section experience-section" id="experience" aria-labelledby="work-title">
    <div class="shell"><div class="section-heading" data-reveal><span class="section-label">실무 경험</span><h2 id="work-title">느린 배치의 병목 분석,<br />적재 결과의 정합성 검증</h2><p>배치 지연의 원인 분석과 적재 검증,<br />서비스의 기능 구현과 반복 작업 개선.</p></div><Experience /></div>
  </section>

  <section class="selected-work" id="cases" aria-labelledby="cases-title">
    <div class="shell section-heading" data-reveal><span class="section-label">대표 사례</span><h2 id="cases-title">SpeakText · ForgeSync</h2></div>
    {projects.filter(x=>x.data.featured).map(project=><ProjectStory project={project} />)}
  </section>

  <section class="section archive-section"><div class="shell"><div class="archive-heading"><span class="section-label">추가 학습 기록</span><h2>복원 가능성과 좌석 정합성</h2></div><div class="more-list">{projects.filter(x=>!x.data.featured).map(x=><a class="more-link" href={withBase(`/projects/${x.id}/`)} data-reveal><div><span class="archive-type">학습 프로젝트</span><h3>{x.data.title}</h3></div><p>{x.data.summary.decision}</p><span>사례 읽기 <span aria-hidden="true">↗</span></span></a>)}</div></div></section>

  <section class="section about-section" id="about"><div class="shell about-grid">
    <div class="about-copy" data-reveal><span class="section-label">함께 일하는 사람으로서</span><h2>서비스 개발 경험과<br />문제를 다시 보는 과정</h2><p>회사에서는 기능을 구현하고 데이터 처리 지연을 개선했습니다. 동아리와 제조지능화 교육을 거치며 ‘어떻게 만들지’ 앞에 ‘누구에게 왜 필요한지’를 놓게 됐습니다.</p></div>
    <div class="credentials">{[...profile.education,...profile.activities].map(x=><details class="credential" data-reveal><summary><div><h3>{x.title}</h3><span>{x.detail}</span></div><span class="disclosure-mark" aria-hidden="true">+</span></summary><p>{x.description}</p></details>)}</div>
  </div></section>

  <section class="contact-section" id="contact"><div class="shell contact-grid" data-reveal><div><span class="section-label">연락</span><h2>채용 · 협업</h2><p>이메일로 연락해 주세요.</p></div><div><ContactLinks /><a class="contact-address" href={`mailto:${profile.email}`}>{profile.email}</a></div></div></section>
</SiteLayout>
