---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectStory from '../components/ProjectStory.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Experience from '../components/Experience.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
import portrait from '../assets/portrait.webp';
const projects = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<SiteLayout title="한석진 | 문제를 이해하고 해결하는 개발자" description="배치 처리 개선, 발화자 편집, 설비 기록 분석과 앱 기획을 담은 개발자 한석진의 포트폴리오">
  <section class="hero shell">
    <div class="identity"><Image src={portrait} alt="개발자 한석진" width={176} loading="eager" /><div><p class="identity-name">한석진</p><p class="identity-role">문제를 이해하고 해결하는 개발자</p></div></div>
    <h1><span>문제를 정의하고,</span>{' '}<span>구현과 검증까지 맡는 개발자</span></h1>
    <div class="hero-actions"><a class="button primary" href="#cases">대표 사례 보기 <span aria-hidden="true">↓</span></a><a class="text-link" href={`mailto:${profile.email}`}>이메일로 연락하기 <span aria-hidden="true">↗</span></a></div>
    <div class="hero-note"><span>백엔드·데이터 파이프라인 실무 경험</span><span>문제 분석 → 해결책 선택 → 구현 → 결과 확인</span></div>
  </section>
  <div class="cases-heading shell" id="cases"><h2>대표 사례</h2><p>발화자 수정, 설비 기록 해석, 앱의 입력 부담을 다뤘습니다. 각 사례에서 문제를 어떻게 바라보고 무엇을 바꿨는지 소개합니다.</p></div>
  {projects.filter(x=>x.data.featured).map(project=><ProjectStory project={project} />)}
  <section class="section soft" id="experience"><div class="shell"><div class="section-intro"><span class="section-label">실무 경험</span><h2>배치 지연 분석부터<br />처리 시간 단축까지</h2><p>매일 실행되는 배치의 지연 원인을 분석하고 처리 시간을 줄였습니다. 개선안 검토부터 구현과 적재 결과 확인까지 직접 담당했습니다.</p></div><Experience /></div></section>
  <section class="section"><div class="shell"><div class="section-intro"><span class="section-label">더 깊이 살펴본 문제</span><h2>복원 가능성과<br />좌석 정합성을 다룬 학습 프로젝트</h2></div><div class="more-list">{projects.filter(x=>!x.data.featured).map(x=><a class="more-link" href={withBase(`/projects/${x.id}/`)}><h3>{x.data.title}</h3><p>{x.data.summary.problem}</p><span>사례 읽기 <span aria-hidden="true">→</span></span></a>)}</div></div></section>
  <section class="section soft" id="about"><div class="shell"><div class="section-intro"><span class="section-label">함께 일하는 사람으로서</span><h2>구현 경험을 바탕으로 한<br />사용자·도메인 문제 탐색</h2></div><div class="about-grid"><div class="about-copy"><p>회사에서는 서비스 기능을 구현하고 데이터 처리 지연을 개선했습니다. 제조지능화 아카데미에서는 제조 공정과 설비 데이터의 활용 방식을 배우고, 이를 개인 프로젝트로 확장했습니다. 이런 경험을 거치며 구현 방법을 정하기 전에 누가 어떤 상황에서 어려움을 겪는지 먼저 살피게 됐습니다.</p><p>멋쟁이사자처럼에서 2024년에는 교육생, 2025년에는 백엔드 운영진으로 활동했습니다. 다른 팀과 창업에 관심 있는 사람들을 만나며, 기술적으로 완성도 있게 만드는 것과 사람들이 실제로 필요로 하는 것이 다를 수 있다는 점을 느꼈습니다.</p><p>지금은 혼자 일을 시작하기 어려웠던 경험을 바탕으로 동시생활 앱을 개발하고 있습니다. 기존 버전의 테스터 피드백을 받은 뒤, 일정 입력과 AI 대화보다 캐릭터 곁에서 각자의 일을 하는 방식으로 기획을 바꿨습니다. 새 버전의 효과는 사용자와 확인할 예정입니다.</p></div><div class="credentials">{[...profile.education,...profile.activities].map(x=><div><h3>{x.title}</h3><p>{x.detail}</p><p class="credential-description">{x.description}</p></div>)}</div></div></div></section>
  <section class="contact-section" id="contact"><div class="shell"><h2>개발자 한석진에게 연락하기</h2><p>채용과 협업 문의는 이메일로 보내주세요.</p><ContactLinks /><a class="contact-address" href={`mailto:${profile.email}`}>{profile.email}</a></div></section>
</SiteLayout>
