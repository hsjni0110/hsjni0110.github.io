---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/paths';
---
<SiteLayout title="페이지를 찾을 수 없습니다 | 한석진" description="요청한 페이지가 없습니다. 한석진 포트폴리오의 첫 화면에서 사례를 살펴보세요.">
  <section class="not-found shell"><span class="section-label">404</span><h1>이 페이지는<br />찾을 수 없습니다.</h1><p class="muted">주소가 바뀌었거나 존재하지 않는 페이지입니다.<br />첫 화면에서 이야기를 이어가세요.</p><a class="button primary" href={withBase('/')}>첫 화면으로 돌아가기 <span aria-hidden="true">→</span></a></section>
</SiteLayout>
