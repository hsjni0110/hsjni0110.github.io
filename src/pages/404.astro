---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/paths';
---
<SiteLayout title="존재하지 않는 페이지 | 한석진" description="요청한 주소에 해당하는 페이지 없음">
  <section class="not-found shell"><span class="section-label">404</span><h1>존재하지 않는 페이지</h1><p class="muted">주소 변경 또는 잘못된 경로</p><a class="button primary" href={withBase('/')}>첫 화면으로 돌아가기 <span aria-hidden="true">→</span></a></section>
</SiteLayout>
